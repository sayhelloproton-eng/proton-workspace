#!/bin/zsh
set -eu

WORKSPACE_ROOT="${PROTON_WORKSPACE_ROOT:-/Users/agent/Desktop/proton-workspace}"
STATE_DIR="$WORKSPACE_ROOT/automation/gptweb-mcp/.runtime/watchdog"
LEGACY_PROFILE_DIR="$HOME/.config/tunnel-client"
SERVICES=(local-dev codegraph repomix playwright-chrome)
BACKOFF_MAX_SECONDS=1800

service_script() {
  case "$1" in
    local-dev) print -r -- "$WORKSPACE_ROOT/tools/local-dev/gptweb-mcp-service.sh" ;;
    codegraph) print -r -- "$WORKSPACE_ROOT/tools/codegraph/gptweb-mcp-service.sh" ;;
    repomix) print -r -- "$WORKSPACE_ROOT/tools/repomix/gptweb-mcp-service.sh" ;;
    playwright-chrome) print -r -- "$WORKSPACE_ROOT/tools/browser/gptweb-mcp-service.sh" ;;
    *) return 2 ;;
  esac
}

legacy_profile_conflicts() {
  local service path
  for service in "${SERVICES[@]}"; do
    path="$LEGACY_PROFILE_DIR/$service.yaml"
    [[ -e "$path" ]] && print -r -- "$path"
  done
}

assert_no_legacy_profiles() {
  local conflicts
  conflicts="$(legacy_profile_conflicts)"
  if [[ -n "$conflicts" ]]; then
    echo "GPTWEB_MCP_OWNER_CONFLICT=LEGACY_PROFILE" >&2
    print -r -- "$conflicts" >&2
    echo "Canonical generated profiles live under automation/gptweb-mcp/.runtime/profiles/." >&2
    return 1
  fi
}

run_service() {
  local service="$1"
  local action="$2"
  /bin/zsh "$(service_script "$service")" "$action"
}

validate_target() {
  case "$1" in
    all|local-dev|codegraph|repomix|playwright-chrome) return 0 ;;
    *)
      echo "Unknown runtime: $1" >&2
      return 2
      ;;
  esac
}

run_all() {
  local action="$1"
  local failed=0
  local service
  for service in "${SERVICES[@]}"; do
    if ! run_service "$service" "$action"; then
      failed=1
    fi
  done
  return "$failed"
}

run_target() {
  local action="$1"
  local target="$2"
  validate_target "$target"
  if [[ "$target" == "all" ]]; then
    run_all "$action"
  else
    run_service "$target" "$action"
  fi
}

show_one_status() {
  local service="$1"
  local health="DOWN"
  if run_service "$service" health >/dev/null 2>&1; then
    health="READY"
  fi
  echo "========== $service [$health] =========="
  run_service "$service" status || true
}

show_status() {
  local target="$1"
  validate_target "$target"
  if [[ "$target" == "all" ]]; then
    local service
    for service in "${SERVICES[@]}"; do
      show_one_status "$service"
      echo
    done
  else
    show_one_status "$target"
  fi
}

restart_target() {
  local target="$1"
  run_target stop "$target" || true
  sleep 1
  run_target start "$target"
}

watchdog_state_file() {
  print -r -- "$STATE_DIR/$1.state"
}

watchdog_service() {
  local service="$1"
  local state_file
  state_file="$(watchdog_state_file "$service")"

  if run_service "$service" health >/dev/null 2>&1; then
    rm -f "$state_file"
    echo "WATCHDOG service=$service state=READY"
    return 0
  fi

  local failures=0
  local next_at=0
  if [[ -r "$state_file" ]]; then
    local state
    state="$(<"$state_file")"
    failures="${state%% *}"
    next_at="${state##* }"
    [[ "$failures" == <-> ]] || failures=0
    [[ "$next_at" == <-> ]] || next_at=0
  fi

  local now
  now="$(date +%s)"
  if (( now < next_at )); then
    echo "WATCHDOG service=$service state=BACKOFF next=$next_at failures=$failures"
    return 0
  fi

  echo "WATCHDOG service=$service state=RECOVERING"
  if run_service "$service" start; then
    rm -f "$state_file"
    echo "WATCHDOG service=$service state=RECOVERED"
    return 0
  fi

  failures=$(( failures + 1 ))
  local delay
  if (( failures >= 6 )); then
    delay=$BACKOFF_MAX_SECONDS
  else
    delay=$(( 60 * (2 ** (failures - 1)) ))
    (( delay > BACKOFF_MAX_SECONDS )) && delay=$BACKOFF_MAX_SECONDS
  fi
  next_at=$(( now + delay ))

  mkdir -p "$STATE_DIR"
  local temporary="${state_file}.tmp.$$"
  printf '%s %s\n' "$failures" "$next_at" > "$temporary"
  mv "$temporary" "$state_file"
  echo "WATCHDOG service=$service state=RECOVERY_FAILED retryIn=${delay}s failures=$failures" >&2
  return 0
}

watchdog_all() {
  mkdir -p "$STATE_DIR"
  local service
  for service in "${SERVICES[@]}"; do
    watchdog_service "$service"
  done
}

command="${1:-status}"
target="${2:-all}"
case "$command" in
  start|reconcile)
    assert_no_legacy_profiles
    run_target start "$target"
    ;;
  stop) run_target stop "$target" ;;
  restart)
    assert_no_legacy_profiles
    restart_target "$target"
    ;;
  status) show_status "$target" ;;
  doctor)
    assert_no_legacy_profiles
    show_status "$target"
    ;;
  watchdog)
    assert_no_legacy_profiles
    watchdog_all
    ;;
  *)
    echo "Usage: gptweb-mcp [start|stop|restart|status|doctor|reconcile|watchdog] [all|local-dev|codegraph|repomix|playwright-chrome]" >&2
    exit 2
    ;;
esac
